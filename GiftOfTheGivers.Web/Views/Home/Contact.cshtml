@{
    ViewData["Title"] = "Contact Us";
}

<div class="container py-4">
    <h1 class="text-success fw-bold">Contact Us</h1>
    <p class="text-muted">Reach out to our response teams or headquarters.</p>

    <div class="row mt-4">
        <div class="col-md-6 mb-3">
            <div class="card border-0 shadow-sm p-4">
                <h5 class="fw-bold"><i class="fa-solid fa-location-dot me-2 text-success"></i>Headquarters</h5>
                <p class="mb-1">Pietermaritzburg, KwaZulu-Natal, South Africa</p>
                <p class="mb-1"><strong>Toll-Free:</strong> 0800 786 911</p>
                <p class="mb-0"><strong>Email:</strong> info@giftofthegivers.org</p>
            </div>
        </div>
        <div class="col-md-6 mb-3">
            <div class="card border-0 shadow-sm p-4">
                <h5 class="fw-bold"><i class="fa-solid fa-clock me-2 text-success"></i>Emergency Operations</h5>
                <p class="mb-0">24/7 Disaster Response Command Center available during active relief deployments.</p>
            </div>
        </div>
    </div>
</div>