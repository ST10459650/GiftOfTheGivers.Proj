@{
    ViewData["Title"] = "Registration Received";
}

<div class="text-center py-5">
    <div class="mb-4 text-success">
        <i class="fa-solid fa-circle-check fa-5x"></i>
    </div>
    <h1 class="fw-bold">Volunteer Registration Recorded!</h1>
    <p class="fs-5 text-muted col-md-8 mx-auto mt-3">
        @TempData["SuccessMessage"]
    </p>
    <p class="text-muted">Our field coordinators will reach out when a disaster deployment matches your skill set in your province.</p>
    <div class="mt-4">
        <a asp-controller="Home" asp-action="Index" class="btn btn-primary me-2">Back to Home</a>
        <a asp-controller="Volunteers" asp-action="Register" class="btn btn-outline-secondary">Register Another Person</a>
    </div>
</div>